# Notification worker settings
HEALTH_ADDR=:8081

# Compose sets the in-network broker URL itself. For a local `go run`, the
# config default is amqp://lms:lms@localhost:5672/ (the published port).
# RABBITMQ_URL=amqp://lms:lms@localhost:5672/

# Policies file inside the container. Compose mounts ./config read-only.
# Empty or unset means no notification policies: every event is acknowledged
# and ignored.
POLICIES_PATH=/app/config/policies.json

# Added in later steps
# DATABASE_URL=host=db port=5432 user=notify password=notify dbname=notify sslmode=disable
