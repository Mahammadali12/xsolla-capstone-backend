# Notification worker settings
HEALTH_ADDR=:8081

# Compose sets the in-network broker URL itself. For a local `go run`, the
# config default is amqp://lms:lms@localhost:5672/ (the published port).
# RABBITMQ_URL=amqp://lms:lms@localhost:5672/

# Confirmation policy stays empty until the notification scope is approved.
POLICIES_PATH=/app/config/policies.json

# Template directory inside the container. Compose mounts ./config/templates.
# Empty or unset means no templates: any enabled policy fails to render.
TEMPLATES_PATH=/app/templates

# Delivery history. The default (config.go) targets the compose Postgres on
# localhost:5433; compose overrides RABBITMQ_URL/DATABASE_URL for the container.
# DATABASE_URL=host=localhost port=5433 user=notify password=notify dbname=notify sslmode=disable

# SMTP email. Leave SMTP_HOST unset to keep logging instead of sending.
# Any SMTP server works; Gmail is just host smtp.gmail.com, port 587, an app
# password, and SMTP_FROM set to the same account.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=Xsolla School <you@gmail.com>
# SMTP_TLS=starttls
