<h1 class="h1 text-ink" style="margin:0 0 16px 0; font-family:Georgia, 'Times New Roman', serif; font-size:28px; line-height:36px; font-weight:700; color:#1B1A22;">Mentor slot booked</h1>
<p class="text-ink" style="margin:0 0 16px 0; font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:26px; color:#1B1A22;">Hi {{.Recipient.Name}},</p>
<p class="text-muted" style="margin:0 0 24px 0; font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:26px; color:#4A4757;">Your mentor slot is confirmed. Here are the details:</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="bg-soft" style="background-color:#F7F6FB; border-radius:12px;">
  <tr>
    <td style="padding:20px 24px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td class="detail-label text-muted" width="40%" valign="top" style="padding:0 0 10px 0; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:20px; color:#6B6878;">Starts</td>
          <td class="detail-value text-ink" valign="top" style="padding:0 0 10px 0; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:20px; font-weight:bold; color:#1B1A22;">{{formatTime .Payload.starts_at}}</td>
        </tr>
        <tr>
          <td class="detail-label text-muted" width="40%" valign="top" style="padding:0; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:20px; color:#6B6878;">Ends</td>
          <td class="detail-value text-ink" valign="top" style="padding:0; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:20px; font-weight:bold; color:#1B1A22;">{{formatTime .Payload.ends_at}}</td>
        </tr>
      </table>
    </td>
  </tr>
</table>
