<h1 class="h1 text-ink" style="margin:0 0 16px 0; font-family:Georgia, 'Times New Roman', serif; font-size:28px; line-height:36px; font-weight:700; color:#1B1A22;">Announcement</h1>
<p class="text-ink" style="margin:0 0 16px 0; font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:26px; color:#1B1A22;">Hi {{.Recipient.Name}},</p>
<p class="text-ink" style="margin:0 0 24px 0; font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:26px; color:#1B1A22; white-space:pre-line;">{{.Payload.message}}</p>
{{if .Payload.link}}<p class="text-muted" style="margin:0 0 24px 0; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:20px; color:#4A4757;">Open it in the LMS: <strong>{{.Payload.link}}</strong></p>
{{end}}<p class="text-muted" style="margin:0; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:20px; color:#6B6878;">Sent by {{.Payload.sent_by_name}}</p>
