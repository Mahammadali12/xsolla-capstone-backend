<h1 class="h1 text-ink" style="margin:0 0 16px 0; font-family:Georgia, 'Times New Roman', serif; font-size:28px; line-height:36px; font-weight:700; color:#1B1A22;">New 1:1 slots</h1>
<p class="text-ink" style="margin:0 0 16px 0; font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:26px; color:#1B1A22;">Hi {{.Recipient.Name}},</p>
<p class="text-muted" style="margin:0 0 24px 0; font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:26px; color:#4A4757;">{{.Payload.mentor_name}} opened new 1:1 slots:</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="bg-soft" style="background-color:#F7F6FB; border-radius:12px;">
  <tr>
    <td style="padding:20px 24px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td class="detail-label text-muted" width="40%" valign="top" style="padding:0 0 10px 0; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:20px; font-weight:bold; color:#6B6878;">Starts</td>
          <td class="detail-value text-muted" valign="top" style="padding:0 0 10px 0; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:20px; font-weight:bold; color:#6B6878;">Ends</td>
        </tr>
        {{range .Payload.slots}}
        <tr>
          <td class="detail-label text-ink" valign="top" style="padding:0 0 6px 0; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:20px; color:#1B1A22;">{{formatTime .starts_at}}</td>
          <td class="detail-value text-ink" valign="top" style="padding:0 0 6px 0; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:20px; color:#1B1A22;">{{formatTime .ends_at}}</td>
        </tr>
        {{end}}
      </table>
    </td>
  </tr>
</table>
